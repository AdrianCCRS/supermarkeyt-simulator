# Copia a deploy/.env y rellena. NO lo subas a git (.env* está en .gitignore).
# Generar cada secreto:  openssl rand -hex 24      (el ADMIN_TOKEN:  openssl rand -hex 32)

DB_NAME=supermarket_simulator
DB_USER=d2
DB_PASS=cambia-esto
DB_ROOT_PASS=cambia-esto-tambien
ADMIN_TOKEN=cambia-esto-por-un-token-largo

# Puerto del servidor donde se publica el juego (solo en 127.0.0.1: delante va tu proxy inverso)
WEB_PORT=8090
